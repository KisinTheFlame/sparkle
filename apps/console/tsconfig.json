{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "paths": {
      "@sparkle/agent-api/*": ["./../../packages/agent-api/src/*"],
      "@sparkle/kernel/*": ["./../../packages/kernel/src/*"],
      "@sparkle/http/*": ["./../../packages/http/src/*"],
      "@sparkle/console-api/*": ["./../../packages/console-api/src/*"],
      "@sparkle/llm-api/*": ["./../../packages/llm-api/src/*"],
      "@sparkle/rpc-client/*": ["./../../packages/rpc-client/src/*"]
    }
  },
  "include": ["src", "test"]
}
