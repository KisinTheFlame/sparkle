{
  "name": "@sparkle/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "pretest": "pnpm --filter \"@sparkle/agent^...\" build",
    "test": "NODE_OPTIONS=--max-old-space-size=2048 vitest run",
    "test:watch": "NODE_OPTIONS=--max-old-space-size=2048 vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sparkle/agent-api": "workspace:*",
    "@sparkle/agent-runtime": "workspace:*",
    "@sparkle/browser-api": "workspace:*",
    "@sparkle/http": "workspace:*",
    "@sparkle/image": "workspace:*",
    "@sparkle/kernel": "workspace:*",
    "@sparkle/feishu-api": "workspace:*",
    "@sparkle/llm": "workspace:*",
    "@sparkle/llm-api": "workspace:*",
    "@sparkle/llm-client": "workspace:*",
    "@sparkle/metric-client": "workspace:*",
    "@sparkle/oss-api": "workspace:*",
    "@sparkle/persistence": "workspace:*",
    "@sparkle/rpc-client": "workspace:*",
    "@sparkle/scheduler-api": "workspace:*",
    "@sparkle/scheduler-client": "workspace:*",
    "fast-xml-parser": "^5.5.9",
    "fastify": "^5.6.2",
    "node-html-parser": "^7.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
